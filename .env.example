# =============================================================================
# KADS LABS — Environment Variables (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development and set real values in
# Vercel → Project Settings → Environment Variables for Production / Preview.
#
# Convention:
#   NEXT_PUBLIC_*  → Exposed to the browser (safe to ship in JS bundles)
#   All other vars  → Server-only secrets (NEVER commit real values; never expose client-side)
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public canonical URL of the deployed site (no trailing slash). Used for SEO
# canonical tags, OAuth redirects, password-reset links and share URLs.
NEXT_PUBLIC_APP_URL=https://kadslabs.com


# -----------------------------------------------------------------------------
# Firebase Authentication (REQUIRED for production)
# -----------------------------------------------------------------------------
# KADS LABS uses Firebase for all user-facing auth:
#   - Google one-tap sign-in
#   - Email / password sign-in + sign-up
#   - Password reset emails
#   - Session management, secure cookies, persistent login, automatic token refresh
#
# Obtain these from: Firebase Console → Project Settings → General → Your apps → Web App config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=          # e.g. kadslabs-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=          # e.g. kadslabs-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=      # e.g. kadslabs-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google Analytics for Firebase (optional) — auto-initializes GA4 via Firebase if set.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# Supabase (REQUIRED for production)
# -----------------------------------------------------------------------------
# Supabase manages Database / Storage / Realtime / Edge Functions.
# Obtain from: Supabase Dashboard → Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS — SERVER ONLY. Never expose to the browser; only
# used by Supabase Edge Functions, Vercel server actions, and migration scripts.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Email (used by Supabase Edge Functions / server actions)
# -----------------------------------------------------------------------------
# SMTP credentials for transactional email (contact-form acknowledgements, password
# resets, invoice notifications, ticket updates). Prefer Resend (see below) for
# deliverability; SMTP is an alternative.
SMTP_HOST=           # e.g. smtp.resend.com or smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KADS LABS <no-reply@kadslabs.com>"


# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project ID for session recordings / heatmaps. Leave empty to disable.
NEXT_PUBLIC_CLARITY_ID=


# -----------------------------------------------------------------------------
# Security (server-only)
# -----------------------------------------------------------------------------
# Strong random secret (≥32 bytes, base64) used to sign internal CSRF tokens and
# short-lived invite links. Generate: `node -e "console.log(crypto.randomBytes(32).toString('base64'))"`.
JWT_SECRET=
# 32-byte key for encrypting sensitive metadata at rest in localStorage (candidate notes, drafts).
ENCRYPTION_KEY=
# Secret used to sign cookie payloads (for cookie-based demo guards / future httpOnly sessions).
COOKIE_SECRET=


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Default Supabase Storage bucket for general uploads. The migration creates
# four buckets: resumes, screenshots, avatars, attachments, project-files.
# This variable overrides the default used by the media library.
SUPABASE_STORAGE_BUCKET=attachments


# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Firebase Cloud Messaging server key for push notifications (server-only).
FCM_SERVER_KEY=
# VAPID public key for browser web-push subscription prompt (NEXT_PUBLIC — exposed to client).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# -----------------------------------------------------------------------------
# Optional Services
# -----------------------------------------------------------------------------
# OpenAI API key — used by the AI Founder Assistant (summarizes tickets, drafts replies).
OPENAI_API_KEY=
# Resend API key for transactional email (preferred over raw SMTP) — used by the
# Supabase `send-email` Edge Function. Create at https://resend.com/api-keys.
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# Admin emails (comma separated)
# -----------------------------------------------------------------------------
# Seeded as founders / super-admins when they first sign up.
NEXT_PUBLIC_ADMIN_EMAILS=ceo@kadslabs.com,founderskadslabs@gmail.com
